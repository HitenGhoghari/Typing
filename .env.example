# =========================================================
#  Typing Test — Environment Variables
# =========================================================
#
#  INSTRUCTIONS:
#    1. Copy this file and rename the copy to  .env
#    2. Replace "your_api_key_here" with your real key
#    3. Never commit the .env file to Git
#
#  Get a free Gemini API key at:
#    https://aistudio.google.com/app/apikey
#
#  Your key should look like this:
#    AIzaSyC-abc123DEF456ghi789JKL012mno345PQR
#    (starts with "AIzaSy", about 39 characters long)
# =========================================================

GEMINI_API_KEY=your_api_key_here